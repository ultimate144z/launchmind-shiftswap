# Brevo (Email — replaces SendGrid)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Email addresses
TEST_EMAIL=your-test-email@example.com
VERIFIED_SENDER_EMAIL=your-verified-sender@example.com

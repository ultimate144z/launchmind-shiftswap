# Copy this file to .env and replace placeholders.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub
GITHUB_TOKEN=ghp_your_github_pat_here
